<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>
    <queries><package android:name="com.termux"/><intent><action android:name="android.media.action.IMAGE_CAPTURE"/></intent></queries>
    <application android:label="DurableAgent" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:backupAgent=".PrivateDataBackupAgent" android:fullBackupOnly="true">
        <provider android:name=".CameraCaptureProvider" android:authorities="${applicationId}.camera" android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".AgentActivity" android:exported="true" android:launchMode="singleTop"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <activity android:name=".ProbeActivity" android:exported="false"/>
        <service android:name=".ApplicationService" android:process=":agent" android:exported="false" android:stopWithTask="false"/>
        <service android:name=".NativeStopService" android:process=":control" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="shortService"/>
        <service android:name=".RuntimeService" android:process=":runtime" android:exported="false" android:stopWithTask="false"/>
        <receiver android:name=".ExecutionBootstrapReceiver" android:exported="false"/>
    </application>
</manifest>
